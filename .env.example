# PromptIQ Environment Configuration Example
# Copy to .env if customizing paths or ports

# Configurable path to trained Keras BiLSTM model
PROMPTIQ_MODEL_PATH=backend/models/best_pels_bilstm_model.keras

# Backend server host and port
HOST=127.0.0.1
PORT=8000

# Set Python default encoding to UTF-8 on Windows
PYTHONUTF8=1
